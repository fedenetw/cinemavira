---
const estive = [
  { anno: 2026, slug: 'estate-2026' },
  { anno: 2025, slug: 'estate-2025' },
  { anno: 2024, slug: 'estate-2024' },
  { anno: 2023, slug: 'estate-2023' },
  { anno: 2022, slug: 'estate-2022' },
  { anno: 2021, slug: 'estate-2021' },
  { anno: 2020, slug: 'estate-2020' },
  { anno: 2019, slug: 'estate-2019' },
  { anno: 2018, slug: 'estate-2018' },
  { anno: 2017, slug: 'estate-2017' },
];

const invernali = [
  { anno: 2020, slug: 'inverno-2020' },
  { anno: 2019, slug: 'inverno-2019' },
  { anno: 2018, slug: 'inverno-2018' },
];

const { type, active } = Astro.props;

const items = type === 'estiva' ? estive : invernali;
const prefix = type === 'estiva' ? 'estate-' : 'inverno-';
---

<nav class="subnav" aria-label={type === 'estiva' ? 'Rassegna estiva' : 'Rassegna invernale'}>
  <div class="subnav-inner">
    {items.map((item) => (
      <a
        href={`../${item.slug}/index.html`}
        class={active === item.slug ? 'active' : undefined}
      >
        {prefix === 'estate-' ? 'Estate' : 'Inverno'} {item.anno}
      </a>
    ))}

    <a
      href="../prezzi/index.html"
      class={active === 'prezzi' ? 'active' : undefined}
    >
      Prezzi
    </a>
  </div>
</nav>
